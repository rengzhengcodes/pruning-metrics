# =============================================================================
# pruning-metrics -- environment template for the four orchestration notebooks
# =============================================================================
# Copy this file to `.env` at the repository root and fill in values:
#   cp template.env .env
# The notebooks load `.env` via python-dotenv ``load_dotenv()`` in the
# bootstrap cell. Never commit `.env`.
#
# Syntax: KEY=value (no spaces around '='). Lines starting with # are ignored.
# Optional quotes: KEY="value with spaces".
# =============================================================================

# -----------------------------------------------------------------------------
# AWS identity / region
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
# Named CLI profile (SSO / shared credentials). Leave empty if unused.
AWS_PROFILE=

# -----------------------------------------------------------------------------
# Notebook-shared S3 + EC2 resources (provisioned by notebook 01)
# -----------------------------------------------------------------------------
# Single S3 bucket for code tarball, calibration / pruning artifacts, and
# downstream eval results. Must be globally unique, follow S3 naming rules.
RESULTS_BUCKET=
# IAM role + instance profile attached to the GPU box. Same name for both;
# bootstrap_ec2_resources.py creates them if missing.
EC2_INSTANCE_PROFILE_NAME=pruning-metrics-ec2
EC2_INSTANCE_ROLE_NAME=pruning-metrics-ec2

# -----------------------------------------------------------------------------
# Pruning calibration knobs (notebook 02 -> run_pruning_calibration.py)
# -----------------------------------------------------------------------------
# Hugging Face model id (any causal LM).
BASE_MODEL_ID=Qwen/Qwen2-72B
# Comma-separated pruning levels (percent sparsity per output row).
PRUNING_LEVELS=0,20,40,60,80
# Seed + train fraction for the seeded fallback split (HumanEval+) and for
# reproducible truncation when MAX_CALIBRATION_SAMPLES caps a native train
# split (GSM8K, ARC). Math/MCQ adapters use native splits when available
# and ignore TRAIN_FRAC except as a fallback.
SPLIT_SEED=65320
TRAIN_FRAC=0.8
MAX_CALIBRATION_SAMPLES=16
MAX_CALIBRATION_TOKENS=512

# -----------------------------------------------------------------------------
# EC2 spot search priorities (used by notebooks 02 / 03 / 04)
# -----------------------------------------------------------------------------
# Preferred GPU instance types in priority order (H100 first, then A100).
EC2_INSTANCE_TYPE_PRIORITY=p5.48xlarge,p4de.24xlarge,p4d.24xlarge
# Regions to try in priority order.
EC2_REGION_PRIORITY=us-east-1,us-west-2,us-east-2

# -----------------------------------------------------------------------------
# Optional -- Hugging Face Hub (gated models or rate limits)
# -----------------------------------------------------------------------------
# HF_TOKEN=
# HUGGINGFACE_HUB_TOKEN=

# =============================================================================
# pruning-metrics — environment template for notebooks and SageMaker scripts
# =============================================================================
# Copy this file to `.env` at the repository root and fill in values:
#   cp template.env .env
# The notebook loads `.env` automatically (see imports cell). Never commit `.env`.
#
# Syntax: KEY=value  (no spaces around '='). Lines starting with # are ignored.
# Optional quotes: KEY="value with spaces"
# =============================================================================

# -----------------------------------------------------------------------------
# AWS account & CLI (identity / region)
# -----------------------------------------------------------------------------
# Region used by boto3 and most CLI commands in this project.
AWS_REGION=us-east-1
# Duplicate often read by SDKs and shells when AWS_REGION is unset.
AWS_DEFAULT_REGION=us-east-1
# 12-digit AWS account ID (used to build ECR image URIs and verify resources).
AWS_ACCOUNT_ID=
# Named CLI profile (IAM Identity Center / SSO or shared credentials). Leave empty to use default profile.
AWS_PROFILE=

# -----------------------------------------------------------------------------
# SageMaker execution role & endpoint hosting
# -----------------------------------------------------------------------------
# IAM role ARN that SageMaker assumes when hosting the model (S3/ECR access from the endpoint).
SAGEMAKER_ROLE_ARN=
# Stable endpoint name; deploy script creates or updates this endpoint.
PRUNING_ENDPOINT_NAME=qwen-pruning-endpoint
# Instance backing the endpoint (must fit model memory; affects cost).
PRUNING_INSTANCE_TYPE=ml.g5.48xlarge
# Number of instances behind the endpoint (usually 1 for dev).
PRUNING_INSTANCE_COUNT=1

# -----------------------------------------------------------------------------
# S3 — pruned checkpoints, manifest, and uploaded artifacts
# -----------------------------------------------------------------------------
# Bucket where prune_and_register.py uploads each pruning level and model_manifest.json.
PRUNING_ARTIFACT_BUCKET=
# Prefix inside the artifact bucket (no leading slash; trailing slash optional in code).
PRUNING_ARTIFACT_PREFIX=qwen-pruning

# -----------------------------------------------------------------------------
# S3 — per-request logits written by the serving container
# -----------------------------------------------------------------------------
# Bucket for inference logits JSONL (can match PRUNING_ARTIFACT_BUCKET).
PRUNING_LOGITS_BUCKET=
# Object key prefix for logits objects under the logits bucket.
PRUNING_LOGITS_PREFIX=logits

# -----------------------------------------------------------------------------
# Local pruning job (WANDA calibration + checkpoint upload)
# -----------------------------------------------------------------------------
# Hugging Face model id or local path used for stats collection and pruned checkpoints.
BASE_MODEL_ID=Qwen/Qwen2.5-Coder-7B-Instruct
# Comma-separated pruning levels (percent sparsity per layer pattern), e.g. 0,20,40.
PRUNING_LEVELS=0,20
# Calibration source: humanevalplus_prompts OR hf:<dataset>:<split>:<field>
CALIBRATION_SOURCE=humanevalplus_prompts
# Max calibration rows and max tokens per row for activation statistics.
MAX_CALIBRATION_SAMPLES=16
MAX_CALIBRATION_TOKENS=512

# -----------------------------------------------------------------------------
# Amazon ECR — container image for SageMaker inference
# -----------------------------------------------------------------------------
# Repository name in ECR (combined with account/region/tag for deploy).
ECR_REPOSITORY_NAME=qwen-serving
# Image tag pushed after docker build (must match what you pushed).
IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Optional — Hugging Face Hub (gated models or rate limits)
# -----------------------------------------------------------------------------
# HF_TOKEN=
# HUGGINGFACE_HUB_TOKEN=

# -----------------------------------------------------------------------------
# Optional — long-lived AWS credentials (prefer SSO/profile or instance role)
# -----------------------------------------------------------------------------
# Do not commit real keys. Prefer AWS_PROFILE or IAM roles. Uncomment only locally.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
